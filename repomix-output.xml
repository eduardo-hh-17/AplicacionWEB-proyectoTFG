'use client'

import { useState, useEffect } from 'react'
import { createClient } from '@supabase/supabase-js'

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
)

// ── TIPOS ──
type Ingrediente = {
  id: number
  nombre: string
  emoji: string
  activo: boolean
}

type Plato = {
  id: number
  nombre: string
  emoji: string
  descripcion: string
  precio: number
  ingredientes: Ingrediente[]
  activo: boolean
}

export default function Menu() {

  // ── ESTADOS ──
  const [platos, setPlatos] = useState<Plato[]>([])
  const [cargando, setCargando] = useState(true)
  const [platoSeleccionado, setPlatoSeleccionado] = useState<Plato | null>(null)
  const [modalAbierto, setModalAbierto] = useState(false)
  const [modalEliminar, setModalEliminar] = useState(false)

  // Campos editables del modal
  const [nombre, setNombre] = useState('')
  const [descripcion, setDescripcion] = useState('')
  const [precio, setPrecio] = useState('')
  const [ingredientes, setIngredientes] = useState<Ingrediente[]>([])
  const [guardando, setGuardando] = useState(false)

  // ── CARGA INICIAL ──
  useEffect(() => {
    cargarPlatos()

    // Escucha cambios en tiempo real
    const canal = supabase
      .channel('platos-cambios')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'platos' }, () => cargarPlatos())
      .subscribe()

    return () => { supabase.removeChannel(canal) }
  }, [])

  // ── FUNCIONES ──

  const cargarPlatos = async () => {
    const { data } = await supabase
      .from('platos')
      .select('*')
      .order('id')
    if (data) setPlatos(data)
    setCargando(false)
  }

  // Abre el modal con los datos del plato
  const abrirModal = (plato: Plato) => {
    setPlatoSeleccionado(plato)
    setNombre(plato.nombre)
    setDescripcion(plato.descripcion)
    setPrecio(plato.precio.toString())
    setIngredientes(
      Array.isArray(plato.ingredientes)
        ? plato.ingredientes.map(ing =>
            typeof ing === 'string'
              ? { id: 0, nombre: ing, emoji: '🍽️', activo: true }
              : ing
          )
        : []
    )
    setModalAbierto(true)
  }

  // Guarda los cambios en Supabase
  const guardarCambios = async () => {
    if (!platoSeleccionado) return
    setGuardando(true)
    await supabase
      .from('platos')
      .update({
        nombre,
        descripcion,
        precio: parseFloat(precio),
        ingredientes,
      })
      .eq('id', platoSeleccionado.id)
    setGuardando(false)
    setModalAbierto(false)
  }

  // Desactiva el plato — desaparece de la web del cliente
  const desactivarPlato = async () => {
    if (!platoSeleccionado) return
    await supabase
      .from('platos')
      .update({ activo: !platoSeleccionado.activo })
      .eq('id', platoSeleccionado.id)
    setModalAbierto(false)
  }

  // Elimina el plato — pregunta confirmación primero
  const eliminarPlato = async () => {
    if (!platoSeleccionado) return
    await supabase
      .from('platos')
      .delete()
      .eq('id', platoSeleccionado.id)
    setModalEliminar(false)
    setModalAbierto(false)
  }

  // Envía el plato a cocina — crea un pedido en Supabase
  const enviarACocina = async () => {
    if (!platoSeleccionado) return
    await supabase
      .from('pedidos')
      .insert({
        plato_nombre: platoSeleccionado.nombre,
        plato_id: platoSeleccionado.id,
        precio: platoSeleccionado.precio,
        ingredientes,
        estado: 'pendiente',
        fecha: new Date().toISOString(),
      })
    setModalAbierto(false)
  }

  // Activa o desactiva un ingrediente
  const toggleIngrediente = (index: number) => {
    setIngredientes(ingredientes.map((ing, i) =>
      i === index ? { ...ing, activo: !ing.activo } : ing
    ))
  }

  if (cargando) return (
    <div className="flex items-center justify-center h-64">
      <p className="text-slate-400">Cargando menú...</p>
    </div>
  )

  return (
    <div>

      {/* ── CABECERA ── */}
      <div className="flex items-center justify-between mb-8">
        <h1 className="text-2xl font-medium text-[#0d1f3c]">Menú</h1>
        <span className="text-slate-400 text-sm">{platos.length} platos</span>
      </div>

      {/* ── GRID DE PLATOS ── */}
      <div className="grid grid-cols-4 gap-4">
        {platos.map((plato) => (
          <button
            key={plato.id}
            onClick={() => abrirModal(plato)}
            className={`bg-white rounded-2xl border text-left overflow-hidden hover:shadow-md transition-all ${plato.activo ? 'border-slate-200' : 'border-red-200 opacity-60'}`}
          >
            {/* Imagen / Emoji */}
            <div className="h-24 bg-[#f8faff] flex items-center justify-center text-5xl border-b border-slate-100">
              {plato.emoji}
            </div>

            {/* Info */}
            <div className="p-4">
              <p className="text-[#0d1f3c] text-sm font-medium mb-1">{plato.nombre}</p>
              <p className="text-slate-400 text-xs mb-3 line-clamp-2 leading-relaxed">{plato.descripcion}</p>
              <div className="flex items-center justify-between">
                <span className="text-blue-600 text-sm font-medium">{plato.precio.toFixed(2)}€</span>
                <span className={`text-[10px] px-2 py-0.5 rounded-full font-medium ${plato.activo ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-500'}`}>
                  {plato.activo ? 'Activo' : 'Inactivo'}
                </span>
              </div>
            </div>
          </button>
        ))}
      </div>

      {/* ── MODAL EDICIÓN ── */}
      {modalAbierto && platoSeleccionado && (
        <div
          onClick={() => setModalAbierto(false)}
          className="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
        >
          <div
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-2xl w-[560px] overflow-hidden shadow-2xl"
          >

            {/* Cabecera modal */}
            <div className="flex items-center justify-between px-6 py-4 border-b border-slate-200">
              <h2 className="text-[#0d1f3c] font-medium">
                {platoSeleccionado.emoji} {platoSeleccionado.nombre}
              </h2>
              <button
                onClick={() => setModalAbierto(false)}
                className="text-slate-400 hover:text-slate-600 text-xl"
              >
                ✕
              </button>
            </div>

            {/* Cuerpo modal — dos columnas */}
            <div className="grid grid-cols-2 gap-0">

              {/* Columna izquierda — campos editables */}
              <div className="p-6 border-r border-slate-200 flex flex-col gap-4">
                <p className="text-[#0d1f3c] text-sm font-medium">Editar plato</p>

                <div>
                  <label className="text-slate-400 text-xs block mb-1">Nombre</label>
                  <input
                    value={nombre}
                    onChange={(e) => setNombre(e.target.value)}
                    className="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-[#0d1f3c] outline-none focus:border-blue-400 transition-colors"
                  />
                </div>

                <div>
                  <label className="text-slate-400 text-xs block mb-1">Descripción</label>
                  <textarea
                    value={descripcion}
                    onChange={(e) => setDescripcion(e.target.value)}
                    rows={3}
                    className="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-[#0d1f3c] outline-none focus:border-blue-400 transition-colors resize-none"
                  />
                </div>

                <div>
                  <label className="text-slate-400 text-xs block mb-1">Precio (€)</label>
                  <input
                    value={precio}
                    onChange={(e) => setPrecio(e.target.value)}
                    type="number"
                    step="0.01"
                    className="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-[#0d1f3c] outline-none focus:border-blue-400 transition-colors"
                  />
                </div>
              </div>

              {/* Columna derecha — ingredientes */}
              <div className="p-6 flex flex-col gap-3">
                <p className="text-[#0d1f3c] text-sm font-medium">Ingredientes</p>
                {ingredientes.length === 0 ? (
                  <p className="text-slate-400 text-xs">Sin ingredientes</p>
                ) : (
                  ingredientes.map((ing, index) => (
                    <div
                      key={index}
                      onClick={() => toggleIngrediente(index)}
                      className={`flex items-center gap-3 px-3 py-2 rounded-xl border cursor-pointer transition-all
                        ${ing.activo
                          ? 'border-slate-200 hover:border-blue-300 hover:bg-blue-50'
                          : 'border-red-200 bg-red-50'
                        }`}
                    >
                      <div className={`w-4 h-4 rounded border-2 flex items-center justify-center flex-shrink-0 transition-all
                        ${ing.activo ? 'bg-[#0d1f3c] border-[#0d1f3c] text-white' : 'bg-white border-slate-300'}`}
                      >
                        {ing.activo && <span className="text-[10px]">✓</span>}
                      </div>
                      <span className="text-base">{ing.emoji}</span>
                      <span className={`text-xs flex-1 ${ing.activo ? 'text-[#0d1f3c]' : 'text-red-400 line-through'}`}>
                        {ing.nombre}
                      </span>
                    </div>
                  ))
                )}
              </div>
            </div>

            {/* Pie modal — botones */}
            <div className="px-6 py-4 border-t border-slate-200 flex items-center gap-2">

              {/* Guardar */}
              <button
                onClick={guardarCambios}
                disabled={guardando}
                className="flex-1 bg-[#0d1f3c] text-white py-2.5 rounded-xl text-sm font-medium hover:bg-[#1e3a6e] transition-colors disabled:opacity-50"
              >
                {guardando ? 'Guardando...' : '💾 Guardar cambios'}
              </button>

              {/* Enviar a cocina */}
              <button
                onClick={enviarACocina}
                className="flex-1 bg-green-600 text-white py-2.5 rounded-xl text-sm font-medium hover:bg-green-700 transition-colors"
              >
                🍳 Enviar a cocina
              </button>

              {/* Desactivar */}
              <button
                onClick={desactivarPlato}
                className="px-4 py-2.5 rounded-xl text-sm font-medium border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors"
              >
                🚫
              </button>

              {/* Eliminar */}
              <button
                onClick={() => setModalEliminar(true)}
                className="px-4 py-2.5 rounded-xl text-sm font-medium bg-red-50 text-red-500 hover:bg-red-100 transition-colors"
              >
                🗑️
              </button>

            </div>
          </div>
        </div>
      )}

      {/* ── MODAL CONFIRMAR ELIMINAR ── */}
      {modalEliminar && (
        <div
          onClick={() => setModalEliminar(false)}
          className="fixed inset-0 bg-black/60 flex items-center justify-center z-[60]"
        >
          <div
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-2xl w-80 p-6 shadow-2xl"
          >
            <div className="text-center mb-6">
              <p className="text-4xl mb-3">🗑️</p>
              <h3 className="text-[#0d1f3c] font-medium text-base mb-2">¿Eliminar plato?</h3>
              <p className="text-slate-400 text-sm">
                Vas a eliminar <strong>{platoSeleccionado?.nombre}</strong> de la base de datos. Esta acción no se puede deshacer.
              </p>
            </div>
            <div className="flex flex-col gap-2">
              <button
                onClick={eliminarPlato}
                className="w-full bg-red-500 text-white py-3 rounded-xl text-sm font-medium hover:bg-red-600 transition-colors"
              >
                Sí, eliminar
              </button>
              <button
                onClick={() => setModalEliminar(false)}
                className="w-full border border-slate-200 text-slate-500 py-3 rounded-xl text-sm hover:bg-slate-50 transition-colors"
              >
                Cancelar
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  )
}
</file>

<file path="src/app/(admin)/pedidos/page.tsx">
'use client'

import { useState, useEffect } from 'react'
import { supabase} from '@/lib/supabase'

// Conexión a Supabase


// Tipos — como clases en Java
type Mesa = {
  id: number
  numero: number
  capacidad: number
  estado: 'libre' | 'ocupada' | 'esperando'
  personas: number
}

type Pedido = {
  id: number
  plato_nombre: string
  precio: number
  estado: string
  mesa: number | null
  ingredientes: any[]
  fecha: string
}

export default function Pedidos() {

  // Estados — como variables de instancia en Java
  const [mesas, setMesas] = useState<Mesa[]>([])
  const [pedidos, setPedidos] = useState<Pedido[]>([])
  const [mesaSeleccionada, setMesaSeleccionada] = useState<Mesa | null>(null)
  const [modalMesa, setModalMesa] = useState(false)
  const [personas, setPersonas] = useState(0)
  const [cargando, setCargando] = useState(true)

  // Carga inicial — como el constructor en Java
  useEffect(() => {
    cargarMesas()
    cargarPedidos()

    // Suscripción en tiempo real — escucha cambios en la base de datos
    const canal = supabase
      .channel('cambios')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'mesas' }, () => cargarMesas())
      .on('postgres_changes', { event: '*', schema: 'public', table: 'pedidos' }, () => cargarPedidos())
      .subscribe()

    // Limpia la suscripción cuando el componente se desmonta
    return () => { supabase.removeChannel(canal) }
  }, [])

  // Carga las mesas desde Supabase
  const cargarMesas = async () => {
    const { data } = await supabase
      .from('mesas')
      .select('*')
      .order('numero')
    if (data) setMesas(data)
    setCargando(false)
  }

  // Carga los pedidos desde Supabase
  const cargarPedidos = async () => {
    const { data } = await supabase
      .from('pedidos')
      .select('*')
      .eq('estado', 'pendiente')
      .order('fecha', { ascending: false })
    if (data) setPedidos(data)
  }

  // Abre el modal de una mesa
  const abrirMesa = (mesa: Mesa) => {
    setMesaSeleccionada(mesa)
    setPersonas(mesa.personas)
    setModalMesa(true)
  }

  // Activa una mesa — la pone como ocupada
  const activarMesa = async () => {
    if (!mesaSeleccionada) return
    await supabase
      .from('mesas')
      .update({ estado: 'ocupada', personas })
      .eq('id', mesaSeleccionada.id)
    setModalMesa(false)
  }

  // Libera una mesa — la pone como libre
  const liberarMesa = async () => {
    if (!mesaSeleccionada) return
    await supabase
      .from('mesas')
      .update({ estado: 'libre', personas: 0 })
      .eq('id', mesaSeleccionada.id)
    setModalMesa(false)
  }

  // Marca un pedido como completado
  const completarPedido = async (id: number) => {
    await supabase
      .from('pedidos')
      .update({ estado: 'completado' })
      .eq('id', id)
  }

  // Color según el estado de la mesa
  const colorMesa = (estado: string) => {
    if (estado === 'ocupada') return 'bg-blue-50 border-blue-300'
    if (estado === 'esperando') return 'bg-orange-50 border-orange-300'
    return 'bg-white border-slate-200'
  }

  const colorBadge = (estado: string) => {
    if (estado === 'ocupada') return 'bg-blue-100 text-blue-700'
    if (estado === 'esperando') return 'bg-orange-100 text-orange-700'
    return 'bg-slate-100 text-slate-500'
  }

  if (cargando) return (
    <div className="flex items-center justify-center h-64">
      <p className="text-slate-400">Cargando...</p>
    </div>
  )

    return (
    <div className="flex gap-8 h-[calc(100vh-120px)]">
        {/* ── COLUMNA IZQUIERDA — MESAS (FIJAS, SIN SCROLL INTERNO) ── */}
        <div className="flex-1 overflow-y-auto">
        <div className="flex items-center justify-between mb-6">
            <h1 className="text-2xl font-medium text-[#0d1f3c]">Mesas</h1>
            <div className="flex items-center gap-3 text-xs">
            <span className="flex items-center gap-1"><span className="w-3 h-3 rounded-full bg-slate-300 inline-block"/> Libre</span>
            <span className="flex items-center gap-1"><span className="w-3 h-3 rounded-full bg-blue-400 inline-block"/> Ocupada</span>
            <span className="flex items-center gap-1"><span className="w-3 h-3 rounded-full bg-orange-400 inline-block"/> Esperando</span>
            </div>
        </div>

        {/* Grid de mesas (sin altura fija, fluye normalmente) */}
        <div className="grid grid-cols-4 gap-4">
            {mesas.map((mesa) => (
            <button
                key={mesa.id}
                onClick={() => abrirMesa(mesa)}
                className={`rounded-2xl border p-4 text-left transition-all hover:shadow-md ${colorMesa(mesa.estado)}`}
            >
                <div className="flex items-center justify-between mb-3">
                <span className="text-[#0d1f3c] font-medium text-sm">Mesa {mesa.numero}</span>
                <span className={`text-[10px] px-2 py-0.5 rounded-full font-medium ${colorBadge(mesa.estado)}`}>
                    {mesa.estado}
                </span>
                </div>
                <div className="flex items-center gap-2 text-slate-400 text-xs">
                <span>👥 {mesa.personas}/{mesa.capacidad}</span>
                </div>
            </button>
            ))}
        </div>
        </div>

        {/* ── COLUMNA DERECHA — PEDIDOS PENDIENTES (CON SCROLL INDEPENDIENTE) ── */}
        <div className="w-80 flex-shrink-0 flex flex-col h-full">
        <h2 className="text-xl font-medium text-[#0d1f3c] mb-6 flex-shrink-0">
            Pedidos pendientes
            {pedidos.length > 0 && (
            <span className="ml-2 bg-blue-500 text-white text-xs px-2 py-0.5 rounded-full">
                {pedidos.length}
            </span>
            )}
        </h2>

        {/* Scroll SOLO para pedidos */}
        <div className="flex-1 overflow-y-auto pr-1 space-y-3">
            {pedidos.length === 0 ? (
            <div className="bg-white rounded-2xl border border-slate-200 p-8 text-center">
                <p className="text-2xl mb-2">✅</p>
                <p className="text-slate-400 text-sm">No hay pedidos pendientes</p>
            </div>
            ) : (
            pedidos.map((pedido) => (
                <div key={pedido.id} className="bg-white rounded-2xl border border-slate-200 p-4">
                <div className="flex items-start justify-between mb-2">
                    <div>
                    <p className="text-[#0d1f3c] text-sm font-medium">{pedido.plato_nombre}</p>
                    <p className="text-slate-400 text-xs mt-0.5">
                        {pedido.mesa ? `Mesa ${pedido.mesa}` : 'Sin mesa'}
                    </p>
                    </div>
                    <p className="text-blue-600 text-sm font-medium">{pedido.precio}€</p>
                </div>

                {/* Ingredientes */}
                {pedido.ingredientes && pedido.ingredientes.length > 0 && (
                    <div className="flex flex-wrap gap-1 mb-3">
                    {pedido.ingredientes.map((ing: any, i: number) => (
                        <span
                        key={i}
                        className={`text-xs px-2 py-0.5 rounded-full ${ing.activo ? 'bg-slate-100 text-slate-600' : 'bg-red-100 text-red-500 line-through'}`}
                        >
                        {ing.emoji} {ing.nombre}
                        </span>
                    ))}
                    </div>
                )}

                <button
                    onClick={() => completarPedido(pedido.id)}
                    className="w-full bg-[#0d1f3c] text-white py-2 rounded-xl text-xs font-medium hover:bg-[#1e3a6e] transition-colors"
                >
                    ✓ Marcar como completado
                </button>
                </div>
            ))
            )}
        </div>
        </div>

        {/* ── MODAL MESA (sin cambios) ── */}
        {modalMesa && mesaSeleccionada && (
        <div
            onClick={() => setModalMesa(false)}
            className="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
        >
            <div
            onClick={(e) => e.stopPropagation()}
            className="bg-white rounded-2xl w-80 overflow-hidden shadow-2xl"
            >
            <div className="flex items-center justify-between px-6 py-4 border-b border-slate-200">
                <h2 className="text-[#0d1f3c] font-medium">Mesa {mesaSeleccionada.numero}</h2>
                <button onClick={() => setModalMesa(false)} className="text-slate-400 hover:text-slate-600">✕</button>
            </div>

            <div className="p-6">
                <div className="flex items-center gap-2 mb-6">
                <span className="text-slate-400 text-sm">Estado:</span>
                <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${colorBadge(mesaSeleccionada.estado)}`}>
                    {mesaSeleccionada.estado}
                </span>
                </div>

                <div className="mb-6">
                <p className="text-[#0d1f3c] text-sm font-medium mb-3">Número de personas</p>
                <div className="flex items-center gap-4">
                    <button
                    onClick={() => setPersonas(Math.max(0, personas - 1))}
                    className="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-[#0d1f3c] hover:bg-slate-50 transition-colors text-lg"
                    >
                    −
                    </button>
                    <span className="text-[#0d1f3c] text-2xl font-medium w-8 text-center">{personas}</span>
                    <button
                    onClick={() => setPersonas(Math.min(mesaSeleccionada.capacidad, personas + 1))}
                    className="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-[#0d1f3c] hover:bg-slate-50 transition-colors text-lg"
                    >
                    +
                    </button>
                    <span className="text-slate-400 text-xs">máx. {mesaSeleccionada.capacidad}</span>
                </div>
                </div>

                <div className="flex flex-col gap-2">
                {mesaSeleccionada.estado === 'libre' ? (
                    <button
                    onClick={activarMesa}
                    className="w-full bg-[#0d1f3c] text-white py-3 rounded-xl text-sm font-medium hover:bg-[#1e3a6e] transition-colors"
                    >
                    ✓ Activar mesa
                    </button>
                ) : (
                    <button
                    onClick={liberarMesa}
                    className="w-full bg-red-500 text-white py-3 rounded-xl text-sm font-medium hover:bg-red-600 transition-colors"
                    >
                    Liberar mesa
                    </button>
                )}
                <button
                    onClick={() => setModalMesa(false)}
                    className="w-full border border-slate-200 text-slate-500 py-3 rounded-xl text-sm hover:bg-slate-50 transition-colors"
                >
                    Cancelar
                </button>
                </div>
            </div>
            </div>
        </div>
        )}
    </div>
    )
}
</file>

<file path="src/app/(cliente)/page.tsx">
'use client'

import { useState, useEffect } from 'react'
import LayoutLateral from '@/components/cliente/LayoutLateral'
import PanelInicio from '@/components/cliente/PanelInicio'
import PanelSobreNosotros from '@/components/cliente/PanelSobreNosotros'
import PanelReservas from '@/components/cliente/PanelReservas'
import PanelContacto from '@/components/cliente/PanelContacto'
import PanelMenu from '@/components/cliente/PanelMenu'
import { supabase } from '@/lib/supabase'

type Vista = 'inicio' | 'sobre' | 'reservas' | 'contacto' | 'menu'

export default function Home() {
  const [vistaActiva, setVistaActiva] = useState<Vista>('inicio')
  const [tokenActivo, setTokenActivo] = useState<string | null>(null)
  const [mesaActiva, setMesaActiva] = useState<number | null>(null)
  const [animando, setAnimando] = useState(false)

  useEffect(() => {
    const urlParams = new URLSearchParams(window.location.search)
    const token = urlParams.get('token')
    const mesa = urlParams.get('mesa')
    
    if (token && mesa) {
      setTokenActivo(token)
      setMesaActiva(parseInt(mesa))
      setVistaActiva('menu')

      // Activa la mesa automáticamente en Supabase
      supabase
        .from('mesas')
        .update({ estado: 'ocupada' })
        .eq('numero', parseInt(mesa))
        .then(({ error }) => {
          if (error) console.error('Error activando mesa:', error)
        })
    }
  }, [])

  const cambiarVista = (nuevaVista: Vista) => {
    // Inicia la animación de salida
    setAnimando(true)
    
    // Espera 200ms (la duración de la animación)
    setTimeout(() => {
      // Cambia el contenido
      setVistaActiva(nuevaVista)
      
      // Pequeño retraso para que la entrada se vea suave
      setTimeout(() => {
        setAnimando(false)
      }, 50)
    }, 200)
  }

  const renderizarPanel = () => {
    switch (vistaActiva) {
      case 'inicio':
        return <PanelInicio />
      case 'sobre':
        return <PanelSobreNosotros />
      case 'reservas':
        return <PanelReservas />
      case 'contacto':
        return <PanelContacto />
      case 'menu':
        return <PanelMenu tokenActivo={tokenActivo} mesaActiva={mesaActiva} />
      default:
        return <PanelInicio />
    }
  }

  return (
    <LayoutLateral 
      vistaActiva={vistaActiva} 
      onCambiarVista={cambiarVista}
    >
      <div className="min-h-[500px] p-4">
        <div className={`transition-all duration-300 ease-out
          ${animando ? 'opacity-0 scale-95' : 'opacity-100 scale-100'}`}>
          {renderizarPanel()}
        </div>
      </div>
    </LayoutLateral>
  )
}
